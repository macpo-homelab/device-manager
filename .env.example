# Lokale Entwicklung: nach .env kopieren und ausfüllen. .env wird nicht eingecheckt.
#
# Passwörter/Secrets verschlüsselt ablegen (Windows DPAPI, nur für deinen Benutzer auf diesem Rechner lesbar):
#   .venv/Scripts/python -m device_manager.envcrypt DM_SHELLY_PASSWORD
# Die ausgegebene Zeile (DM_SHELLY_PASSWORD=dpapi:...) hier eintragen. Klartext funktioniert weiterhin.
# Gilt für: DM_SHELLY_PASSWORD, DM_WIFI_PASSWORD, DM_OPNSENSE_API_KEY, DM_OPNSENSE_API_SECRET, DM_MQTT_PASSWORD
DM_DATA_DIR=./data
DM_BIND_HOST=127.0.0.1
DM_PORT=8099
# Log-Level: debug | info | warning | error. Log-Datei: <DM_DATA_DIR>/logs/device_manager.log
# debug zeigt jeden Aufruf an Shelly/OPNsense/Zigbee2MQTT (ohne Passwörter).
DM_LOG_LEVEL=info
# Erlaubte Host-Header (JSON-Liste). Bei Zugriff über einen anderen Namen/IP ergänzen.
DM_ALLOWED_HOSTS=["127.0.0.1", "localhost", "::1"]

# Shelly: Master-Passwort – jedes Gerät erhält ein daraus abgeleitetes eigenes Passwort (Benutzer admin)
DM_SHELLY_PASSWORD=
# Gerätenetze (JSON-Liste, CIDR), in denen Geräte übernommen werden dürfen. Leer = alle privaten Adressen.
DM_DEVICE_NETWORKS=[]

# WLAN für Gen4-Zigbee-Geräte (temporäre WLAN-Aktivierung)
DM_WIFI_SSID=
DM_WIFI_PASSWORD=

# OPNsense
DM_OPNSENSE_URL=https://opnsense.lan
DM_OPNSENSE_API_KEY=
DM_OPNSENSE_API_SECRET=
DM_OPNSENSE_VERIFY_TLS=true
# CA-Zertifikat (PEM), mit dem das OPNsense-Webzertifikat signiert ist – nötig bei interner CA.
# OPNsense: System > Trust > Authorities > CA > Download (Zertifikat, nicht den Schlüssel).
DM_OPNSENSE_CA_FILE=./data/opnsense-ca.pem
# Nach jeder geänderten Reservierung Unbound neu laden (DNS-Name sofort auflösbar).
# Voraussetzung: Unbound registriert DHCP-Reservierungen, API-Recht "Services: Unbound DNS".
DM_OPNSENSE_RELOAD_UNBOUND=true

# Standardeinstellungen für neue Geräte (Assistent). Den NTP-Server verteilt der Button in der Geräteliste
# auf alle Geräte, z. B. nach einer Änderung hier.
DM_SHELLY_NTP_SERVER=time.cloudflare.com
DM_SHELLY_TIMEZONE=Europe/Berlin
DM_SHELLY_DATE_FORMAT=YYYY-MM-DD
# Standort für Sonnenauf-/-untergang (z. B. 52.52 / 13.40); leer = am Gerät nicht ändern
DM_SHELLY_LATITUDE=
DM_SHELLY_LONGITUDE=
# Einzelne Standardeinstellungen (false = am Gerät nicht ändern); AP-Passwort wird immer gesetzt
DM_SHELLY_ECO_MODE=true
DM_SHELLY_DISABLE_AP=true
DM_SHELLY_DISABLE_BLE=true
DM_SHELLY_LED_OFF=true
# Vorauswahl im Assistenten „Neues Gerät“
DM_PROVISION_UPDATE=true
DM_PROVISION_DEFAULTS=true
DM_PROVISION_CERTIFICATE=true
# Alle Werte dieses Abschnitts lassen sich auch in der Oberfläche unter „Einstellungen“ ändern (Vorrang vor .env).

# Firmware-Update: Abfrageintervall (s) und Wartezeit (s), bis der Anwender um einen Neustart gebeten wird
DM_FIRMWARE_POLL_INTERVAL=10
DM_FIRMWARE_REBOOT_WAIT=300

# IP-Bereich für Reservierungen
DM_IP_RANGE_START=192.168.10.100
DM_IP_RANGE_END=192.168.10.199

# Zertifikate
DM_DNS_DOMAIN=lan
DM_CERT_CA_NAME=Interne CA
DM_CERT_LIFETIME_DAYS=397

# MQTT / Zigbee2MQTT
DM_MQTT_HOST=
DM_MQTT_PORT=1883
DM_MQTT_USERNAME=
DM_MQTT_PASSWORD=
DM_Z2M_BASE_TOPIC=zigbee2mqtt
